        "outputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "case_sensitive": {
              "type": "boolean"
            },
            "matches": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer"
                  },
                  "preview_start_line": {
                    "type": "integer"
                  },
                  "preview_end_line": {
                    "type": "integer"
                  },
                  "preview": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "line",
                  "preview_start_line",
                  "preview_end_line",
                  "preview"
                ],
                "additionalProperties": false
              }
            },
            "truncated": {
              "type": "boolean"
            },
            "visited_entries": {
              "type": "integer"
            },
            "files_scanned": {
              "type": "integer"
            },
            "bytes_scanned": {
              "type": "integer"
            }
          },
          "required": [
            "query",
            "path",
            "case_sensitive",
            "matches",
            "truncated",
            "visited_entries",
            "files_scanned",
            "bytes_scanned"
          ],
          "additionalProperties": false
