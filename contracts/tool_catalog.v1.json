      "availability": {},
      "definition": {
        "name": "write_file",
        "description": "Create, overwrite, or append to a file inside the shared directory. Optional expected_version protects existing targets from stale writes.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "relative_path": {
              "type": "string",
              "description": "Relative file path."
            },
            "content": {
              "type": "string",
              "description": "UTF-8 text content."
            },
            "append": {
              "type": "boolean",
              "default": false
            },
            "expected_version": {
              "type": "string",
              "maxLength": 4096,
              "description": "Optional opaque strong file version token. When provided for an existing target, the write commits only if the version still matches immediately before publish."
            }
          },
          "required": [
            "relative_path",
            "content"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "result": {
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        }
