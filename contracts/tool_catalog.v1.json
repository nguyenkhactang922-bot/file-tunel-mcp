            },
            "start_line": {
              "type": "integer",
              "minimum": 1,
              "description": "1-based first line to return."
            },
            "end_line": {
              "type": "integer",
              "minimum": 1,
              "description": "1-based last line to return (inclusive)."
            }
          },
          "required": [
