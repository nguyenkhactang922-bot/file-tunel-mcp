  "instructionVersion": "1.0.0",
  "instructions": {
    "base": "Read and manage files, Git repositories, Codex project skills, and optionally local commands inside the configured shared directory. When a user message begins with '/<skill-name>', call load_codex_skill with that exact name before answering and follow the returned SKILL.md instructions.",
    "observabilitySuffix": " For local observability, call filemcp_observability_connect once for this chat context, then include the returned chat_instance_id as _filemcp_chat on later FileMCP tool calls. The handle is correlation metadata only and grants no additional authority."
  },
  "facades": {
    "correlationArgument": {
      "name": "_filemcp_chat",
      "definition": {
        "type": "string",
        "description": "Optional opaque FileMCP correlation handle returned by filemcp_observability_connect. It is observability metadata only and grants no additional authority."
      }
    }
  },
