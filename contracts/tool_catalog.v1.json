    {
      "name": "apply_edits",
      "handler": "local_tools",
      "risk": "high",
      "effect": "write",
      "capabilities": [
        "filesystem.write"
      ],
      "availability": {},
      "definition": {
        "name": "apply_edits",
        "description": "Atomically apply versioned UTF-8 text range edits to an existing file. Requires expected_version and fails closed on stale/version/path/policy/cancellation checks.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "relative_path": {
              "type": "string",
              "description": "Relative file path."
            },
            "expected_version": {
              "type": "string",
              "maxLength": 4096,
              "description": "Required opaque strong version token from read_file/read_file_range."
            },
            "coordinate_system": {
              "type": "string",
              "enum": [
                "byte",
                "lineColumn"
              ]
            },
            "column_encoding": {
              "type": "string",
              "enum": [
                "utf8CodePoint"
              ],
              "description": "Required only for lineColumn."
            },
            "edits": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "items": {
                "type": "object"
              }
            },
            "dry_run": {
              "type": "boolean",
              "default": false
            },
            "preserve_line_endings": {
              "type": "boolean",
              "default": true
            },
            "preserve_bom": {
              "type": "boolean",
              "default": true
            }
          },
          "required": [
            "relative_path",
            "expected_version",
            "coordinate_system",
            "edits"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "dry_run": {
              "type": "boolean"
            },
            "committed": {
              "type": "boolean"
            },
            "edits_applied": {
              "type": "integer"
            },
            "bytes_before": {
              "type": "integer"
            },
            "bytes_after": {
              "type": "integer"
            },
            "coordinate_system": {
              "type": "string"
            },
            "column_encoding": {
              "type": [
                "string",
                "null"
              ]
            },
            "before_version": {
              "type": "string"
            },
            "after_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "preserved_bom": {
              "type": "boolean"
            },
            "line_ending": {
              "type": "string"
            },
            "preview": {
              "type": "string"
            },
            "cancelled_after_commit": {
              "type": "boolean"
            }
          },
          "required": [
            "dry_run",
            "committed",
            "edits_applied",
            "bytes_before",
            "bytes_after",
            "coordinate_system",
            "before_version",
            "preserved_bom",
            "line_ending",
            "column_encoding",
            "after_version"
          ],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        }
      }
