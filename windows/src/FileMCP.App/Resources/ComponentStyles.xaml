<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FileMcpPageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource FileMcpTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="FileMcpSectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource FileMcpTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="FileMcpBodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource FileMcpTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="FileMcpCaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource FileMcpTextSecondaryBrush}"/>
    </Style>

    <Style x:Key="FileMcpCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FileMcpSurfaceCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FileMcpBorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource FileMcpRadiusMedium}"/>
        <Setter Property="Padding" Value="{DynamicResource FileMcpSpace16}"/>
    </Style>

    <Style x:Key="FileMcpPrimaryButton" TargetType="Button">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
