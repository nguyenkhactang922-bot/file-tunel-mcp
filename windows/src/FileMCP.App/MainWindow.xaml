<Window x:Class="FileMCP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FileMCP.App.Controls"
        Title="FileMCP" Width="980" Height="760" MinWidth="860" MinHeight="650"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource FileMcpSurfaceAppBrush}"
        Foreground="{DynamicResource FileMcpTextPrimaryBrush}"
        Icon="Assets/filemcp.ico">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FileMcpKeyboardFocusVisual}"/>
        </Style>
        <Style x:Key="WorkspaceLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OverviewCardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource FileMcpBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style x:Key="OverviewLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FileMcpTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="OverviewValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
    <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavigationColumn" Width="188"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border x:Name="NavigationRail" Grid.Column="0"
            Background="{DynamicResource FileMcpSurfaceSidebarBrush}"
            BorderBrush="{DynamicResource FileMcpBorderSubtleBrush}"
            BorderThickness="0,0,1,0"
            Padding="10">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
                <Grid Margin="2,2,2,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="NavigationBrand">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="FileMCP"/>
                        <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Local agent gateway"/>
                    </StackPanel>
                    <Button x:Name="CompactNavigationButton" Grid.Column="1" Content="Collapse"
                            Padding="8,4" Click="CompactNavigation_Click"
                            AutomationProperties.Name="Toggle compact navigation"/>
                </Grid>

                <Button x:Name="NavOnboardingButton" Content="Setup" HorizontalContentAlignment="Left"
                        Margin="0,0,0,4" Click="NavigateOnboarding_Click" AutomationProperties.Name="Setup" Visibility="Collapsed"/>
                <Button x:Name="NavHomeButton" Content="Home" HorizontalContentAlignment="Left"
                        Margin="0,0,0,4" Click="NavigateHome_Click" AutomationProperties.Name="Home"/>
                <Button x:Name="NavWorkspacesButton" Content="Workspaces" HorizontalContentAlignment="Left"
                        Margin="0,0,0,4" Click="NavigateWorkspaces_Click" AutomationProperties.Name="Workspaces"/>
                <Button x:Name="NavConnectionsButton" Content="Connections" HorizontalContentAlignment="Left"
                        Margin="0,0,0,4" Click="NavigateConnections_Click" AutomationProperties.Name="Connections"/>
                <Button x:Name="NavSettingsButton" Content="Settings" HorizontalContentAlignment="Left"
                        Margin="0,0,0,4" Click="NavigateSettings_Click" AutomationProperties.Name="Settings"/>
                <Button x:Name="NavActivityButton" Content="Activity" HorizontalContentAlignment="Left"
                        Margin="0,0,0,4" Click="NavigateActivity_Click" AutomationProperties.Name="Activity"/>
                <Button x:Name="NavChangesButton" Content="Changes" HorizontalContentAlignment="Left"
                        Margin="0,0,0,4" Click="NavigateChanges_Click" AutomationProperties.Name="Changes"/>
                <Button x:Name="NavEvidenceButton" Content="Evidence" HorizontalContentAlignment="Left"
                        Margin="0,0,0,4" Click="NavigateEvidence_Click" AutomationProperties.Name="Evidence"/>
                <Button x:Name="NavRepositoryButton" Content="Repository" HorizontalContentAlignment="Left"
                        Margin="0,0,0,4" Click="NavigateRepository_Click" AutomationProperties.Name="Repository intelligence"/>
                <Button x:Name="NavTerminalButton" Content="Terminal" HorizontalContentAlignment="Left"
                        Margin="0,0,0,4" Click="NavigateTerminal_Click" AutomationProperties.Name="Terminal PTY sessions"/>
                <Button x:Name="NavRecoveryButton" Content="Recovery" HorizontalContentAlignment="Left"
                        Margin="0,0,0,4" Click="NavigateRecovery_Click" AutomationProperties.Name="Recovery quarantine and checkpoints"/>
                <Button x:Name="NavArtifactsButton" Content="Artifacts" HorizontalContentAlignment="Left"
                        Margin="0,0,0,4" Click="NavigateArtifacts_Click" AutomationProperties.Name="Artifacts and batch results"/>
                <Button x:Name="NavBackendButton" Content="Backend" HorizontalContentAlignment="Left"
                        Margin="0,0,0,4" Click="NavigateBackend_Click" AutomationProperties.Name="Backend and isolation status"/>
                <Button x:Name="NavDiagnosticsButton" Content="Diagnostics" HorizontalContentAlignment="Left"
                        Margin="0,8,0,4" Click="NavigateDiagnostics_Click" AutomationProperties.Name="Diagnostics"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="2,12,2,2">
                <controls:StatusBadge x:Name="ShellStatusBadge" Status="Stopped" HorizontalAlignment="Left"/>
                <TextBlock x:Name="ShellWorkspaceText" Style="{StaticResource FileMcpCaptionText}"
                           Text="Workspaces C Ã‚| D Ã‚| E Ã‚| F" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Column="1" Margin="12,0,0,0" BorderThickness="0">
        <TabControl.Resources>
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>
        </TabControl.Resources>
            <TabItem Header="Setup" x:Name="OnboardingTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <controls:PageHeader Title="Welcome to FileMCP"
                                             Description="First-run setup reuses existing workspace, policy, credential and runtime authority."
                                             Margin="0,0,0,12"/>
                        <TextBlock x:Name="OnboardingSummaryText" Text="Complete the steps below, then test the real runtime connection." TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource FileMcpCardBorder}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="1. Workspace"/>
                                    <TextBlock x:Name="OnboardingWorkspaceStatusText" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Choose at least one existing workspace root." TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Configure workspace" Click="OnboardingWorkspace_Click" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource FileMcpCardBorder}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="2. Policy"/>
                                    <TextBlock x:Name="OnboardingPolicyStatusText" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Choose the local policy profile enforced by the server." TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Choose policy" Click="OnboardingPolicy_Click" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource FileMcpCardBorder}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="3. Credential &amp; tunnel"/>
                                    <TextBlock x:Name="OnboardingCredentialStatusText" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Store the runtime API key securely and configure Tunnel IDs." TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Configure connection" Click="OnboardingConnection_Click" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource FileMcpCardBorder}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="4. Test connection"/>
                                    <TextBlock x:Name="OnboardingConnectionStatusText" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Not tested. PASS requires every enabled runtime to report Running." TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="OnboardingTestButton" Grid.Column="1" Content="Test connection" Click="OnboardingTestConnection_Click" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Content="Home" Click="NavigateHome_Click" Margin="0,0,8,0"/>
                            <Button x:Name="OnboardingFinishButton" Content="Finish setup" Click="OnboardingFinish_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Home" x:Name="OverviewTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <controls:PageHeader x:Name="HomeHeader"
                                             Title="Home"
                                             Description="Operational health, active workspaces and current agent activity."
                                             ShowStatus="True"
                                             Status="Stopped"
                                             Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HomeSummaryText" Style="{StaticResource FileMcpCaptionText}" Text="Runtime stopped"/>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock x:Name="OverviewClockText" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="OverviewAppUptimeText" Margin="0,3,0,0" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Active workspaces"/>
                                    <TextBlock x:Name="HomeActiveWorkspacesText" FontWeight="SemiBold" Text="None"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Running work"/>
                                    <TextBlock x:Name="HomeRunningWorkText" FontWeight="SemiBold" Text="0 runtimes"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Latest important event"/>
                                    <TextBlock x:Name="HomeRecentEventText" Text="No recent issue" TextWrapping="Wrap" MaxWidth="260"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Connections" Margin="0,0,8,0" Click="NavigateConnections_Click"/>
                                    <Button Content="Settings" Click="NavigateSettings_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Text="Period"/>
                            <ComboBox x:Name="OverviewPeriodCombo" Grid.Column="1" Height="30" SelectedIndex="0">
                                <ComboBoxItem Content="Today" Tag="Today"/>
                                <ComboBoxItem Content="Yesterday" Tag="Yesterday"/>
                                <ComboBoxItem Content="7 days" Tag="SevenDays"/>
                                <ComboBoxItem Content="30 days" Tag="ThirtyDays"/>
                            </ComboBox>
                            <TextBlock x:Name="OverviewPeriodRangeText" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource FileMcpTextSecondaryBrush}"/>
                            <TextBlock x:Name="OverviewPeriodUpdatedText" Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Not loaded"/>
                        </Grid>
<Border Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="MCP tokens in (est.)"/>
                                    <TextBlock x:Name="OverviewTokenInText" Style="{StaticResource OverviewValueStyle}" Text="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="MCP tokens out (est.)"/>
                                    <TextBlock x:Name="OverviewTokenOutText" Style="{StaticResource OverviewValueStyle}" Text="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Total MCP tokens (est.)"/>
                                    <TextBlock x:Name="OverviewTokenTotalText" Style="{StaticResource OverviewValueStyle}" Text="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource OverviewCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Input payload"/>
                                    <TextBlock x:Name="OverviewInputBytesText" Style="{StaticResource OverviewValueStyle}" Text="0 B"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource OverviewCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Output payload"/>
                                    <TextBlock x:Name="OverviewOutputBytesText" Style="{StaticResource OverviewValueStyle}" Text="0 B"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Total payload"/>
                                    <TextBlock x:Name="OverviewTotalBytesText" Style="{StaticResource OverviewValueStyle}" Text="0 B"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Margin="0,4,0,8" FontWeight="SemiBold" Text="Tool activity"/>
                        <Border Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Calls"/><TextBlock x:Name="OverviewToolCallsText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Tasks"/><TextBlock x:Name="OverviewExecutionTasksText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Read"/><TextBlock x:Name="OverviewReadCallsText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Write"/><TextBlock x:Name="OverviewWriteCallsText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Command"/><TextBlock x:Name="OverviewCommandCallsText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="5"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Git"/><TextBlock x:Name="OverviewGitCallsText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="6"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Skill"/><TextBlock x:Name="OverviewSkillCallsText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="7"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Errors"/><TextBlock x:Name="OverviewErrorsText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,4,0,8" FontWeight="SemiBold" Text="Realtime activity - last 15 minutes"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource OverviewCardStyle}">
                                <StackPanel><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Connected runtimes"/><TextBlock x:Name="OverviewConnectedRuntimesText" Style="{StaticResource OverviewValueStyle}" Text="0 / 4"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource OverviewCardStyle}">
                                <StackPanel><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Average tool latency"/><TextBlock x:Name="OverviewAverageLatencyText" Style="{StaticResource OverviewValueStyle}" Text="0 ms"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource OverviewCardStyle}">
                                <StackPanel><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Max tool latency"/><TextBlock x:Name="OverviewMaxLatencyText" Style="{StaticResource OverviewValueStyle}" Text="0 ms"/></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,10">
                                <StackPanel><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Persistent telemetry"/><TextBlock x:Name="OverviewTelemetryHealthText" Style="{StaticResource OverviewValueStyle}" Text="Starting"/></StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Calls / second and MCP token estimate / second"/>
                                    <TextBlock x:Name="OverviewRealtimeCurrentText" Grid.Column="1" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Calls/s: 0 | Tokens est./s: 0"/>
                                </Grid>
                                <Canvas x:Name="OverviewRealtimeCanvas" Height="190" ClipToBounds="True" Background="{DynamicResource FileMcpSurfaceRaisedBrush}">
                                    <Polyline x:Name="OverviewCallsPolyline" Stroke="{DynamicResource FileMcpStatusInfoBrush}" StrokeThickness="2"/>
                                    <Polyline x:Name="OverviewTokensPolyline" Stroke="{DynamicResource FileMcpStatusSuccessBrush}" StrokeThickness="2"/>
                                </Canvas>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <TextBlock Foreground="{DynamicResource FileMcpStatusInfoBrush}" FontWeight="SemiBold" Text="Calls/s" Margin="0,0,18,0"/>
                                    <TextBlock Foreground="{DynamicResource FileMcpStatusSuccessBrush}" FontWeight="SemiBold" Text="MCP token est./s"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="0,4,0,8" FontWeight="SemiBold" Text="Workspaces"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource OverviewCardStyle}">
                                <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="Drive C"/><TextBlock x:Name="COverviewStatusText" Margin="0,5,0,0" Text="Stopped"/><TextBlock x:Name="COverviewUptimeText" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Uptime: -"/><TextBlock x:Name="COverviewHealthText" Margin="0,3,0,0" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="MCP: down | Tunnel: down | Health: unknown"/><TextBlock x:Name="COverviewCallsText" Margin="0,6,0,0" Text="Calls: 0"/><TextBlock x:Name="COverviewTokensText" Text="MCP tokens (est.): 0"/></StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,10">
                                <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="Drive D"/><TextBlock x:Name="DOverviewStatusText" Margin="0,5,0,0" Text="Stopped"/><TextBlock x:Name="DOverviewUptimeText" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Uptime: -"/><TextBlock x:Name="DOverviewHealthText" Margin="0,3,0,0" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="MCP: down | Tunnel: down | Health: unknown"/><TextBlock x:Name="DOverviewCallsText" Margin="0,6,0,0" Text="Calls: 0"/><TextBlock x:Name="DOverviewTokensText" Text="MCP tokens (est.): 0"/></StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OverviewCardStyle}">
                                <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="Drive E"/><TextBlock x:Name="EOverviewStatusText" Margin="0,5,0,0" Text="Stopped"/><TextBlock x:Name="EOverviewUptimeText" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Uptime: -"/><TextBlock x:Name="EOverviewHealthText" Margin="0,3,0,0" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="MCP: down | Tunnel: down | Health: unknown"/><TextBlock x:Name="EOverviewCallsText" Margin="0,6,0,0" Text="Calls: 0"/><TextBlock x:Name="EOverviewTokensText" Text="MCP tokens (est.): 0"/></StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,10">
                                <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="Drive F"/><TextBlock x:Name="FOverviewStatusText" Margin="0,5,0,0" Text="Stopped"/><TextBlock x:Name="FOverviewUptimeText" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Uptime: -"/><TextBlock x:Name="FOverviewHealthText" Margin="0,3,0,0" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="MCP: down | Tunnel: down | Health: unknown"/><TextBlock x:Name="FOverviewCallsText" Margin="0,6,0,0" Text="Calls: 0"/><TextBlock x:Name="FOverviewTokensText" Text="MCP tokens (est.): 0"/></StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Margin="0,6,0,8" FontWeight="SemiBold" Text="AI chats"/>
                        <TextBlock x:Name="OverviewSessionSummaryText" Margin="0,0,0,8" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="No correlated AI chats yet."/>
                        <DataGrid x:Name="OverviewSessionsGrid" Height="190" Margin="0,0,0,10"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="OverviewSessionsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80"/>
                                <DataGridTextColumn Header="Observed ID" Binding="{Binding DisplayId}" Width="150"/>
                                <DataGridTextColumn Header="Workspace" Binding="{Binding Workspaces}" Width="100"/>
                                <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="150"/>
                                <DataGridTextColumn Header="Calls" Binding="{Binding Calls}" Width="80"/>
                                <DataGridTextColumn Header="Tokens est." Binding="{Binding Tokens}" Width="100"/>
                                <DataGridTextColumn Header="Errors" Binding="{Binding Errors}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Selected session detail"/>
                                <TextBlock x:Name="OverviewSessionDetailText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Select an AI chat or unbound activity row."/>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="* Token values are deterministic estimates from accepted MCP JSON payload bytes (bytes_div_4_v1). They are not ChatGPT account/model token usage."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Workspaces" x:Name="WorkspacesTab">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <controls:PageHeader Title="Workspaces" Description="Configured roots, health and policy context." Margin="0,0,0,12"/>
                        <Button x:Name="WorkspaceCRow" Content="Drive C" Tag="C" Click="WorkspaceRow_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                        <Button x:Name="WorkspaceDRow" Content="Drive D" Tag="D" Click="WorkspaceRow_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                        <Button x:Name="WorkspaceERow" Content="Drive E" Tag="E" Click="WorkspaceRow_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                        <Button x:Name="WorkspaceFRow" Content="Drive F" Tag="F" Click="WorkspaceRow_Click" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource FileMcpCardBorder}">
                        <StackPanel>
                            <TextBlock x:Name="WorkspaceDetailTitle" Style="{StaticResource FileMcpSectionTitleText}" Text="Select a workspace"/>
                            <controls:StatusBadge x:Name="WorkspaceDetailStatus" Status="Unavailable" HorizontalAlignment="Left" Margin="0,8,0,12"/>
                            <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Root"/>
                            <TextBlock x:Name="WorkspaceDetailRoot" Text="-" TextWrapping="Wrap" Margin="0,2,0,10"/>
                            <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Policy profile"/>
                            <TextBlock x:Name="WorkspaceDetailPolicy" Text="-" Margin="0,2,0,10"/>
                            <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Connection"/>
                            <TextBlock x:Name="WorkspaceDetailConnection" Text="-" TextWrapping="Wrap" Margin="0,2,0,10"/>
                            <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Activity"/>
                            <TextBlock x:Name="WorkspaceDetailActivity" Text="-" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Connection" x:Name="ConnectionTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <controls:PageHeader x:Name="ConnectionsHeader"
                                             Title="Connections"
                                             Description="Runtime credentials, Secure MCP Tunnel configuration and connectivity health."
                                             ShowStatus="True"
                                             Status="Stopped"
                                             Margin="0,0,0,12"/>
                        <Border Style="{StaticResource FileMcpCardBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <controls:StatusBadge x:Name="ConnectionCredentialBadge" Status="Unavailable" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" Text="Runtime credential"/>
                                    <TextBlock x:Name="ConnectionDiagnosticsText" Style="{StaticResource FileMcpCaptionText}"
                                               Text="No runtime is connected." TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Runtime API key"/>
                            <PasswordBox x:Name="ApiKeyBox" Grid.Column="1"
                                         ToolTip="One Runtime API key is shared by all enabled FileMCP workspaces and stored in Windows Credential Manager."/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="140,6,0,0">
                            <TextBlock x:Name="ApiKeyStatusText" VerticalAlignment="Center" Foreground="{DynamicResource FileMcpTextSecondaryBrush}"/>
                            <Button x:Name="DeleteApiKeyButton" Margin="12,0,0,0" Content="Delete API key" Click="DeleteApiKey_Click"/>
                        </StackPanel>

                        <TextBlock Margin="0,16,0,8" FontWeight="SemiBold" Text="Workspace tunnels"/>
                        <Border BorderBrush="{DynamicResource FileMcpBorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="Drive"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="Tunnel ID"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Text="Status"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="C"/>
                                <TextBox x:Name="CTunnelIdBox" Grid.Row="2" Grid.Column="1" Margin="0,0,10,0"/>
                                <TextBlock x:Name="CStatusText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Disabled"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="D"/>
                                <TextBox x:Name="DTunnelIdBox" Grid.Row="4" Grid.Column="1" Margin="0,0,10,0"/>
                                <TextBlock x:Name="DStatusText" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Disabled"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="E"/>
                                <TextBox x:Name="ETunnelIdBox" Grid.Row="6" Grid.Column="1" Margin="0,0,10,0"/>
                                <TextBlock x:Name="EStatusText" Grid.Row="6" Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Disabled"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="F"/>
                                <TextBox x:Name="FTunnelIdBox" Grid.Row="8" Grid.Column="1" Margin="0,0,10,0"/>
                                <TextBlock x:Name="FStatusText" Grid.Row="8" Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" Text="Disabled"/>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Each enabled drive uses its own local MCP port, profile and Secure MCP Tunnel while remaining inside this single FileMCP desktop app."/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="SaveConnectionButton" Content="Save connection" Margin="0,0,8,0" Click="SaveConnection_Click"/>
                            <Button x:Name="ConnectButton" Content="Connect all" Width="130" Click="Connect_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings" x:Name="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <controls:PageHeader Title="Settings"
                                             Description="Workspace access, policy, execution, Git, telemetry and appearance."
                                             Margin="0,0,0,12"/>
                        <TextBlock Style="{StaticResource FileMcpSectionTitleText}" Text="Workspace &amp; access"/>
                        <TextBlock FontWeight="SemiBold" Text="Workspace roots" Margin="0,6,0,0"/>
                        <TextBlock Margin="0,4,0,10" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Enable the drives you want FileMCP to expose. Every workspace remains isolated to its configured root."/>

                        <Border BorderBrush="{DynamicResource FileMcpBorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="Use"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="Drive"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Text="Shared directory"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" FontWeight="SemiBold" Text=""/>

                                <CheckBox x:Name="CEnabledCheckBox" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource WorkspaceLabelStyle}" Text="C"/>
                                <TextBox x:Name="CPathBox" Grid.Row="2" Grid.Column="2" Margin="0,0,8,0"/>
                                <Button Grid.Row="2" Grid.Column="3" Tag="C" Content="Browse..." Click="BrowseDirectory_Click"/>

                                <CheckBox x:Name="DEnabledCheckBox" Grid.Row="4" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource WorkspaceLabelStyle}" Text="D"/>
                                <TextBox x:Name="DPathBox" Grid.Row="4" Grid.Column="2" Margin="0,0,8,0"/>
                                <Button Grid.Row="4" Grid.Column="3" Tag="D" Content="Browse..." Click="BrowseDirectory_Click"/>

                                <CheckBox x:Name="EEnabledCheckBox" Grid.Row="6" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource WorkspaceLabelStyle}" Text="E"/>
                                <TextBox x:Name="EPathBox" Grid.Row="6" Grid.Column="2" Margin="0,0,8,0"/>
                                <Button Grid.Row="6" Grid.Column="3" Tag="E" Content="Browse..." Click="BrowseDirectory_Click"/>

                                <CheckBox x:Name="FEnabledCheckBox" Grid.Row="8" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource WorkspaceLabelStyle}" Text="F"/>
                                <TextBox x:Name="FPathBox" Grid.Row="8" Grid.Column="2" Margin="0,0,8,0"/>
                                <Button Grid.Row="8" Grid.Column="3" Tag="F" Content="Browse..." Click="BrowseDirectory_Click"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource FileMcpCardBorder}" Margin="0,16,0,0">
                            <StackPanel>
                            <TextBlock Style="{StaticResource FileMcpSectionTitleText}" Text="Policy"/>
                            <TextBlock Text="Execution policy" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <ComboBox x:Name="PolicyProfileComboBox" Margin="0,6,0,0" SelectedValuePath="Tag" SelectionChanged="PolicyProfileComboBox_SelectionChanged">
                                <ComboBoxItem Content="Restricted (legacy-safe compatibility)" Tag="restricted"/>
                                <ComboBoxItem Content="Workspace auto" Tag="workspace-auto"/>
                                <ComboBoxItem Content="Custom (advanced local policy)" Tag="custom"/>
                                <ComboBoxItem Content="Legacy command compatible (migrated only)" Tag="legacy-command-compatible" IsEnabled="False"/>
                            </ComboBox>
                            <TextBlock x:Name="PolicyExplanationText" Margin="0,5,0,0" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" TextWrapping="Wrap"
                                       Text="Policy is owned by local settings."/>
                            <CheckBox x:Name="EnableCommandsCheckBox" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="AdvancedExpander" Header="Advanced execution, Git &amp; telemetry" Margin="0,16,0,0">
                            <StackPanel Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="Drive"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="Profile"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Text="MCP port"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" FontWeight="SemiBold" Text="Health listener"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="C"/>
                                    <TextBox x:Name="CProfileBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,0"/>
                                    <TextBox x:Name="CPortBox" Grid.Row="2" Grid.Column="2" Margin="0,0,8,0"/>
                                    <TextBox x:Name="CHealthBox" Grid.Row="2" Grid.Column="3"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="D"/>
                                    <TextBox x:Name="DProfileBox" Grid.Row="4" Grid.Column="1" Margin="0,0,8,0"/>
                                    <TextBox x:Name="DPortBox" Grid.Row="4" Grid.Column="2" Margin="0,0,8,0"/>
                                    <TextBox x:Name="DHealthBox" Grid.Row="4" Grid.Column="3"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="E"/>
                                    <TextBox x:Name="EProfileBox" Grid.Row="6" Grid.Column="1" Margin="0,0,8,0"/>
                                    <TextBox x:Name="EPortBox" Grid.Row="6" Grid.Column="2" Margin="0,0,8,0"/>
                                    <TextBox x:Name="EHealthBox" Grid.Row="6" Grid.Column="3"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="F"/>
                                    <TextBox x:Name="FProfileBox" Grid.Row="8" Grid.Column="1" Margin="0,0,8,0"/>
                                    <TextBox x:Name="FPortBox" Grid.Row="8" Grid.Column="2" Margin="0,0,8,0"/>
                                    <TextBox x:Name="FHealthBox" Grid.Row="8" Grid.Column="3"/>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Git name"/>
                                    <TextBox x:Name="GitNameBox" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Git email"/>
                                    <TextBox x:Name="GitEmailBox" Grid.Row="2" Grid.Column="1"/>
                                </Grid>

                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="Exec environment allowlist" FontWeight="SemiBold"/>
                                    <TextBox x:Name="ExecEnvironmentAllowListBox" Margin="0,6,0,0"/>
                                    <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" TextWrapping="Wrap"
                                               Text="Comma-separated environment names or glob patterns allowed for exec_process pass-through/request overrides. Empty by default. Secret-like names require an exact entry; wildcard matches never forward them."/>
                                </StackPanel>

                                <Border Margin="0,16,0,0" Padding="12" BorderBrush="{DynamicResource FileMcpBorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <CheckBox x:Name="OtlpEnabledCheckBox" Content="Enable optional OTLP telemetry export (HTTP/Protobuf)"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="OTLP endpoint"/>
                                            <TextBox x:Name="OtlpEndpointBox" Grid.Column="1"/>
                                        </Grid>
                                        <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource FileMcpTextSecondaryBrush}" TextWrapping="Wrap"
                                                   Text="Disabled by default. FileMCP exports only bounded metadata/metrics; it does not export tool arguments, file contents, raw chat handles, or baggage. Endpoint must be a base http(s) collector URI; FileMCP adds /v1/traces and /v1/metrics."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <Border Style="{StaticResource FileMcpCardBorder}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FileMcpSectionTitleText}" Text="Appearance"/>
                                <TextBlock Margin="0,6,0,0" Text="Follows system appearance and high-contrast settings."/>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource FileMcpCaptionText}"
                                           Text="Manual theme override is not exposed because the current desktop shell follows system resources."/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="SaveSettingsButton" Content="Save settings" HorizontalAlignment="Right" Margin="0,16,0,0" Click="SaveSettings_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Activity" x:Name="ActivityTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <controls:PageHeader Title="Activity"
                                             Description="Structured runtime, workspace and error events. Raw logs remain under Diagnostics."/>
                        <ComboBox x:Name="ActivityFilterCombo" Grid.Column="1" SelectedIndex="0"
                                  SelectionChanged="ActivityFilterCombo_SelectionChanged">
                            <ComboBoxItem Content="All activity" Tag="all"/>
                            <ComboBoxItem Content="Errors only" Tag="error"/>
                            <ComboBoxItem Content="Workspace/runtime" Tag="runtime"/>
                            <ComboBoxItem Content="Settings/connection" Tag="settings"/>
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="ActivityGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  SelectionMode="Single"
                                  SelectionChanged="ActivityGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="110"/>
                                <DataGridTextColumn Header="Workspace" Binding="{Binding Workspace}" Width="90"/>
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource FileMcpCardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FileMcpSectionTitleText}" Text="Event detail"/>
                                <TextBlock x:Name="ActivityDetailText" Margin="0,8,0,0" Text="Select an activity event." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="ActivityCountText" Grid.Row="2" Margin="0,8,0,0"
                               Style="{StaticResource FileMcpCaptionText}" Text="0 events"/>
                </Grid>
            </TabItem>



            <TabItem Header="Changes" x:Name="ChangesTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <controls:PageHeader Title="Changes"
                                         Description="Observed mutation results, version context and stale/conflict states. No synthetic diff is generated."/>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="ChangesGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  SelectionMode="Single"
                                  SelectionChanged="ChangesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Workspace" Binding="{Binding Workspace}" Width="90"/>
                                <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="120"/>
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource FileMcpCardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FileMcpSectionTitleText}" Text="Change detail"/>
                                <controls:StatusBadge x:Name="ChangeDetailStatus" Status="Unavailable" HorizontalAlignment="Left" Margin="0,8,0,8"/>
                                <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="File / target"/>
                                <TextBlock x:Name="ChangeDetailTarget" Text="Not emitted by runtime event" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Version context"/>
                                <TextBlock x:Name="ChangeDetailVersion" Text="Not emitted by runtime event" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Preview / result"/>
                                <TextBox x:Name="ChangeDetailText" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" MinHeight="160"
                                         Text="Select a captured mutation event."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="ChangesCountText" Grid.Row="2" Margin="0,8,0,0"
                               Style="{StaticResource FileMcpCaptionText}"
                               Text="0 captured mutation events"/>
                </Grid>
            </TabItem>



            <TabItem Header="Evidence" x:Name="EvidenceTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <controls:PageHeader Title="Evidence"
                                         Description="Server-owned verification records with source, policy and catalog linkage."/>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="EvidenceGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  SelectionMode="Single"
                                  SelectionChanged="EvidenceGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90"/>
                                <DataGridTextColumn Header="State" Binding="{Binding DisplayState}" Width="100"/>
                                <DataGridTextColumn Header="Workspace" Binding="{Binding Workspace}" Width="90"/>
                                <DataGridTextColumn Header="Criterion" Binding="{Binding Criterion}" Width="150"/>
                                <DataGridTextColumn Header="Evidence ID" Binding="{Binding EvidenceId}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource FileMcpCardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FileMcpSectionTitleText}" Text="Evidence detail"/>
                                <controls:StatusBadge x:Name="EvidenceDetailStatus" Status="Unavailable" HorizontalAlignment="Left" Margin="0,8,0,8"/>
                                <TextBlock x:Name="EvidenceDetailText" Text="Select an evidence record." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="EvidenceCountText" Grid.Row="2" Margin="0,8,0,0"
                               Style="{StaticResource FileMcpCaptionText}"
                               Text="0 captured evidence records"/>
                </Grid>
            </TabItem>

            <TabItem Header="Repository" x:Name="RepositoryTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <controls:PageHeader Title="Repository Intelligence"
                                         Description="Observed read-only repository map, symbol and relation metadata. Provider completeness is heuristic and never grants authority or exhaustive source truth."/>
                    <Border Grid.Row="1" Style="{StaticResource FileMcpCardBorder}" Margin="0,12,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Provider / completeness"/>
                            <TextBlock x:Name="RepositoryProviderText" FontWeight="SemiBold" Text="No repository-intelligence result captured yet." TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Latest observed result" Margin="0,8,0,0"/>
                            <TextBlock x:Name="RepositorySummaryText" Text="Waiting for real repo_map, symbol_search or related_files output." TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Source state" Margin="0,8,0,0"/>
                            <TextBlock x:Name="RepositorySourceText" Text="Not observed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="RepositoryResultGrid"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  EnableRowVirtualization="True" SelectionMode="Single"
                                  SelectionChanged="RepositoryResultGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
                                <DataGridTextColumn Header="Workspace" Binding="{Binding Workspace}" Width="85"/>
                                <DataGridTextColumn Header="Query" Binding="{Binding QueryKind}" Width="110"/>
                                <DataGridTextColumn Header="Returned" Binding="{Binding CountDisplay}" Width="90"/>
                                <DataGridTextColumn Header="State" Binding="{Binding StateDisplay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="RepositoryItemGrid" Grid.Column="1" Margin="12,0,0,0"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  EnableRowVirtualization="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/>
                                <DataGridTextColumn Header="Name / language" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90"/>
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*"/>
                                <DataGridTextColumn Header="Score" Binding="{Binding ScoreDisplay}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <TextBlock x:Name="RepositoryResultCountText" Grid.Row="3" Margin="0,8,0,0"
                               Style="{StaticResource FileMcpCaptionText}"
                               Text="0 captured repository-intelligence results"/>
                </Grid>
            </TabItem>

            <TabItem Header="Terminal" x:Name="TerminalTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <controls:PageHeader Title="Terminal / PTY"
                                         Description="Live workspace-scoped PTY sessions. Output is read in bounded windows and is not copied into FileMCP activity/evidence telemetry."/>
                    <Border Grid.Row="1" Style="{StaticResource FileMcpCardBorder}" Margin="0,12,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Backend / session capability"/>
                                <TextBlock x:Name="TerminalBackendText" FontWeight="SemiBold" Text="No live PTY observation yet." TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Local policy"/>
                                <TextBlock x:Name="TerminalPolicyText" FontWeight="SemiBold" Text="No connected workspace selected." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="TerminalSessionGrid"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  EnableRowVirtualization="True" SelectionMode="Single"
                                  SelectionChanged="TerminalSessionGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Workspace" Binding="{Binding Workspace}" Width="80"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding PidDisplay}" Width="70"/>
                                <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="*"/>
                                <DataGridTextColumn Header="Last activity" Binding="{Binding LastActivityDisplay}" Width="115"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Column="1" Margin="12,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TerminalSelectionText" Style="{StaticResource FileMcpSectionTitleText}" Text="Select a PTY session"/>
                            <TextBox x:Name="TerminalOutputText" Grid.Row="1" Margin="0,8,0,8"
                                     IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                     AutomationProperties.Name="Bounded live terminal output"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button x:Name="TerminalCtrlCButton" Content="Ctrl+C" Margin="0,0,8,0" Padding="10,5" Click="TerminalCtrlC_Click" IsEnabled="False"/>
                                <Button x:Name="TerminalStopButton" Content="Stop" Margin="0,0,16,0" Padding="10,5" Click="TerminalStop_Click" IsEnabled="False"/>
                                <TextBlock VerticalAlignment="Center" Text="Cols" Margin="0,0,4,0"/>
                                <TextBox x:Name="TerminalColumnsBox" Width="46" Text="120" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center" Text="Rows" Margin="0,0,4,0"/>
                                <TextBox x:Name="TerminalRowsBox" Width="46" Text="30" Margin="0,0,8,0"/>
                                <Button x:Name="TerminalResizeButton" Content="Resize" Padding="10,5" Click="TerminalResize_Click" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="TerminalStatusText" Grid.Row="3" Margin="0,8,0,0"
                               Style="{StaticResource FileMcpCaptionText}"
                               Text="0 observed PTY sessions | restart resume is unsupported"/>
                </Grid>
            </TabItem>

            <TabItem Header="Recovery" x:Name="RecoveryTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <controls:PageHeader Title="Recovery"
                                         Description="Workspace-scoped quarantine and checkpoint recovery. Restore actions remain subject to core policy, version checks and rollback safeguards."/>
                    <Border Grid.Row="1" Style="{StaticResource FileMcpCardBorder}" Margin="0,12,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Observed workspace / authority"/>
                                <TextBlock x:Name="RecoveryWorkspaceText" FontWeight="SemiBold" Text="No connected workspace selected." TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Local policy"/>
                                <TextBlock x:Name="RecoveryPolicyText" FontWeight="SemiBold" Text="Presentation grants no authority." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource FileMcpSectionTitleText}" Text="Quarantine" Margin="0,0,0,6"/>
                            <DataGrid x:Name="RecoveryQuarantineGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      EnableRowVirtualization="True" SelectionMode="Single" SelectionChanged="RecoveryQuarantineGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Workspace" Binding="{Binding Workspace}" Width="78"/>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="115"/>
                                    <DataGridTextColumn Header="Path" Binding="{Binding OriginalPath}" Width="*"/>
                                    <DataGridTextColumn Header="Entries" Binding="{Binding EntryCount}" Width="72"/>
                                    <DataGridTextColumn Header="Expires" Binding="{Binding ExpiryDisplay}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Style="{StaticResource FileMcpSectionTitleText}" Text="Checkpoints" Margin="0,0,0,6"/>
                            <DataGrid x:Name="RecoveryCheckpointGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      EnableRowVirtualization="True" SelectionMode="Single" SelectionChanged="RecoveryCheckpointGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Workspace" Binding="{Binding Workspace}" Width="78"/>
                                    <DataGridTextColumn Header="Repository" Binding="{Binding RepositoryPath}" Width="*"/>
                                    <DataGridTextColumn Header="Entries" Binding="{Binding EntryCount}" Width="72"/>
                                    <DataGridTextColumn Header="Excluded" Binding="{Binding ExcludedCount}" Width="76"/>
                                    <DataGridTextColumn Header="Expires" Binding="{Binding ExpiryDisplay}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="3" Style="{StaticResource FileMcpCardBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="RecoveryDetailTitle" Style="{StaticResource FileMcpSectionTitleText}" Text="Select a quarantine item or checkpoint"/>
                            <TextBlock x:Name="RecoveryDetailText" Margin="0,6,0,8" Text="No synthetic recovery state is shown." TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Refresh" Padding="10,5" Margin="0,0,8,0" Click="RecoveryRefresh_Click"/>
                                <Button x:Name="RecoveryRestoreQuarantineButton" Content="Restore quarantine" Padding="10,5" Margin="0,0,8,0" Click="RecoveryRestoreQuarantine_Click" IsEnabled="False"/>
                                <Button x:Name="RecoveryPlanCheckpointButton" Content="Plan checkpoint restore" Padding="10,5" Margin="0,0,8,0" Click="RecoveryPlanCheckpoint_Click" IsEnabled="False"/>
                                <Button x:Name="RecoveryRestoreCheckpointButton" Content="Restore checkpoint" Padding="10,5" Click="RecoveryRestoreCheckpoint_Click" IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="RecoveryStatusText" Grid.Row="4" Margin="0,8,0,0" Style="{StaticResource FileMcpCaptionText}"
                               Text="0 quarantine items | 0 checkpoints | partial recovery is surfaced explicitly"/>
                </Grid>
            </TabItem>

            <TabItem Header="Artifacts" x:Name="ArtifactsTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <controls:PageHeader Title="Artifacts &amp; Batch"
                                         Description="Observed batch results and ContentRef metadata. Inline content and opaque ContentRef tokens are never copied into this view."/>

                    <Border Grid.Row="1" Style="{StaticResource FileMcpCardBorder}" Margin="0,12,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Latest batch"/>
                                <TextBlock x:Name="ArtifactBatchSummaryText" FontWeight="SemiBold" Text="No batch result captured yet." TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FileMcpCaptionText}" Text="Artifact / quota observation"/>
                                <TextBlock x:Name="ArtifactQuotaSummaryText" FontWeight="SemiBold"
                                           Text="Quota usage remaining is not emitted by batch results." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid x:Name="ArtifactBatchGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  EnableRowVirtualization="True"
                                  SelectionChanged="ArtifactBatchGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
                                <DataGridTextColumn Header="Workspace" Binding="{Binding Workspace}" Width="85"/>
                                <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="100"/>
                                <DataGridTextColumn Header="Completed" Binding="{Binding CompletionDisplay}" Width="90"/>
                                <DataGridTextColumn Header="State" Binding="{Binding StateDisplay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Column="1" Margin="12,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="ArtifactEntryGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      EnableRowVirtualization="True"
                                      SelectionChanged="ArtifactEntryGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                                    <DataGridTextColumn Header="Delivery" Binding="{Binding Delivery}" Width="100"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90"/>
                                    <DataGridTextColumn Header="Expires" Binding="{Binding ExpiryDisplay}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="1" Style="{StaticResource FileMcpCardBorder}" Margin="0,12,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource FileMcpSectionTitleText}" Text="Entry detail"/>
                                        <controls:StatusBadge x:Name="ArtifactEntryStatus" Status="Unavailable" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ArtifactEntryDetailText" Margin="0,8,0,0"
                                               Text="Select a captured batch entry." TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="ArtifactBatchCountText" Grid.Row="3" Margin="0,8,0,0"
                               Style="{StaticResource FileMcpCaptionText}"
                               Text="0 captured batch results"/>
                </Grid>
            </TabItem>

            <TabItem Header="Backend" x:Name="BackendTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <controls:PageHeader Title="Backend / Isolation"
                                         Description="Read-only execution backend truth. Presentation never selects or expands backend authority."/>
                    <Border Grid.Row="1" Style="{StaticResource FileMcpCardBorder}" Margin="0,12,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BackendSummaryText" Text="No connected backend observed." TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="Refresh" Padding="10,5" Margin="12,0,0,0" Click="BackendRefresh_Click"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="BackendGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  EnableRowVirtualization="True" SelectionMode="Single" SelectionChanged="BackendGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Workspace" Binding="{Binding Workspace}" Width="78"/>
                                <DataGridTextColumn Header="Backend" Binding="{Binding BackendDisplay}" Width="150"/>
                                <DataGridTextColumn Header="State" Binding="{Binding StateDisplay}" Width="110"/>
                                <DataGridTextColumn Header="Isolation" Binding="{Binding IsolationDisplay}" Width="95"/>
                                <DataGridTextColumn Header="Network" Binding="{Binding NetworkMode}" Width="100"/>
                                <DataGridTextColumn Header="Resource" Binding="{Binding ResourceMode}" Width="120"/>
                                <DataGridTextColumn Header="Docker" Binding="{Binding DockerDisplay}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="1" Style="{StaticResource FileMcpCardBorder}" Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FileMcpSectionTitleText}" Text="Selected backend truth"/>
                                <TextBlock x:Name="BackendDetailText" Margin="0,8,0,0" Text="Select a workspace backend." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="BackendStatusText" Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource FileMcpCaptionText}"
                               Text="presentation_grants_authority=false | Docker not selected means not probed, not available." TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics">
                <Grid Margin="10">
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Background="{DynamicResource FileMcpSurfaceCodeBrush}" Foreground="{DynamicResource FileMcpCodeTextBrush}"/>
                </Grid>
            </TabItem>
    </TabControl>
</Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource FileMcpTextSecondaryBrush}"
                       Text="Closing the window keeps FileMCP running in the system tray."/>
            <Button Grid.Column="1" Content="Quit FileMCP" Click="Quit_Click"/>
        </Grid>
    </Grid>
</Window>
